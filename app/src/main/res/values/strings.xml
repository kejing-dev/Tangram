    <!-- pieces / rules (content.rulesPage) -->
    <string name="name_l">big triangle</string>
    <string name="name_m">middle triangle</string>
    <string name="name_s">small triangle</string>
    <string name="name_sq">square</string>
    <string name="name_p">parallelogram</string>
    <string name="names_line">Big triangle ×2 · Middle triangle · Small triangle ×2 · Square · Parallelogram</string>
    <string name="rules_1">Use all seven pieces. No stacking.</string>
    <string name="rules_2">Drop one in the shadow. If it fits, it clicks down.</string>
    <string name="rules_3">The parallelogram is the only one you flip. Won\'t fit? Flip it.</string>
    <string name="mistake_1">The two big triangles are twins. Either one works.</string>
    <string name="mistake_2">Flipping a triangle or the square does nothing. Just turn it.</string>
    <string name="mistake_3">Stuck? Turn on the hint. The seams show up in the shadow.</string>
    <string name="rules_source">Tangram comes from Qing-dynasty China. It was a craze in Europe and America in the 1800s, and over 6,500 puzzles have been published.</string>
    <string name="rules_mistakes">Common slips</string> <!-- added -->

    <!-- replay reasons (content.replayReasons) -->
    <string name="why_l">Big triangles first. They\'re half the picture.</string>
    <string name="why_m">The middle triangle goes where a right angle fits snugly.</string>
    <string name="why_sq">The square sits in a square spot, or turns 45° to make a point.</string>
    <string name="why_p">The parallelogram leans. If it won\'t fit, flip it.</string>
    <string name="why_s">The two little triangles fill the last corners.</string>

